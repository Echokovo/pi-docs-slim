{
  "name": "@ssk_dev/pi-docs-slim",
  "version": "0.4.1",
  "description": "Keep Pi's built-in documentation guidance out of the system prompt unless you ask for it with /pi. Fork of pi-slim, updated for Pi 0.87.1+ (tested on 1.4).",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "prompt",
    "token-efficient"
  ],
  "author": "kunkun9527",
  "contributors": [
    "Rob Zolkos <rob@zolkos.com> (original pi-slim)",
    "Echokovo (https://github.com/Echokovo)"
  ],
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/kunkun9527/pi-docs-slim#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kunkun9527/pi-docs-slim.git"
  },
  "bugs": {
    "url": "https://github.com/kunkun9527/pi-docs-slim/issues"
  },
  "files": [
    "extensions",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/remove-pi-docs.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/integration.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.87.1"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
